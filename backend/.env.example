# PostgreSQL is supported; SQLite is convenient for local development.
DATABASE_URL=sqlite:///./atlas.db
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# Writes are disabled unless a private key is configured. Send X-API-Key.
ADMIN_API_KEY=
HTTP_TIMEOUT_SECONDS=20
CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=120

# AI: configure keys only on the backend. Without a key, retrieval stays evidence-only.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
LLM_TIMEOUT_SECONDS=35
AI_TIMEOUT_SECONDS=100
AI_MAX_CONCURRENT=4
RAG_MAX_CHUNKS=5000
# Local alternative: LLM_PROVIDER=ollama, set an installed chat model and a
# 768-dimensional embedding model (e.g. embeddinggemma); no cloud key is needed.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional scientific abstract discovery (opt-in for each chat request).
OPENALEX_ENABLED=false
OPENALEX_API_KEY=

# Optional shared evidence graph. Without these, every answer still has a local graph.
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# External marine sources. Keep credentials on the backend only.
GFW_API_KEY=
IUCN_API_KEY=
COPERNICUSMARINE_SERVICE_USERNAME=
COPERNICUSMARINE_SERVICE_PASSWORD=
# OBIS, WoRMS, GBIF, ARGO, NASA CMR metadata and NOAA discovery need no key.
# NASA granule downloads are not enabled by the CMR metadata connector.
